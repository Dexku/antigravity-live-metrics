{
  "name": "antigravity-live-metrics",
  "version": "2.0.0",
  "description": "Native Antigravity UI plugin (Sidecar Aux Pane) displaying live token speed (tok/s), latency (TTFT / Stream), context window usage, cache hit rate, and call history",
  "type": "module",
  "bin": {
    "antigravity-live-metrics": "./bin/cli.mjs"
  },
  "scripts": {
    "install-plugin": "node ./bin/cli.mjs install",
    "uninstall-plugin": "node ./bin/cli.mjs uninstall",
    "doctor": "node ./bin/cli.mjs doctor"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": [
    "antigravity",
    "plugin",
    "sidecar",
    "metrics",
    "tokens",
    "ttft",
    "context-window"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Dexku/antigravity-live-metrics.git"
  },
  "homepage": "https://github.com/Dexku/antigravity-live-metrics#readme",
  "license": "MIT"
}
